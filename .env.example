# Exemplo de variáveis de ambiente para a aplicação Lista de Tarefas
PORT=8080
NODE_ENV=development
GCP_PROJECT_ID=seu-project-id

# Configurações do Firebase Web SDK (Preencher com suas credenciais)
FIREBASE_API_KEY=sua-api-key-aqui
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
FIREBASE_APP_ID=seu-app-id
FIREBASE_MEASUREMENT_ID=seu-measurement-id
